(version 1)
(rule "rp2350_core_corner"
	(condition "A.NetName == 'DVDD' || A.NetName == '/rp-core/RP_LX' || A.NetName == '/rp-core/VREG_AVDD'")
	(constraint clearance (min 0.12mm)))
(rule "default_clearance"
	(condition "A.NetName != 'DVDD' && A.NetName != '/rp-core/RP_LX' && A.NetName != '/rp-core/VREG_AVDD' && B.NetName != 'DVDD' && B.NetName != '/rp-core/RP_LX' && B.NetName != '/rp-core/VREG_AVDD'")
	(constraint clearance (min 0.15mm)))
(rule "j1_gnd_spokes"
	(condition "A.memberOfFootprint('J1')")
	(constraint min_resolved_spokes 1))
(rule "rp2350_core_gnd_solid"
	(condition "A.NetName == 'GND' && (A.memberOfFootprint('C10') || A.memberOfFootprint('C15') || A.memberOfFootprint('C16') || A.memberOfFootprint('U1'))")
	(constraint zone_connection solid))
