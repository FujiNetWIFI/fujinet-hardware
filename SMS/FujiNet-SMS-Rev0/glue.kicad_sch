	(text "fujinet-firmware pico/sms sms_cart.h: sms_glue_oe(), sms_glue_we().  RD, WR, CE = the console's\n/RD, /WR, /CE asserted; GAME, MBOX, RAM_WE, LOAD = RP GPIO38, 35, 39, 40; PWR_OK = console +5V present.\n\nCEP_N = !(CE & PWR_OK)  [U4D, U8A]\nWIN8 = A15 & !A14 & !A13, the $8000-$9FFF load window  [U4E, U6B]\nMBA_N = !(MBOX & A13 & A12)  [U7A];  MBA = !MBA_N  [U4F]\nSLOT2_NM = A15 & !A14 & MBA_N: slot 2 less the live mailbox arena  [U6C]\nOE_ADDR = !A15 | SLOT2_NM = !HIGH16 & !(MBOX & ARENA)  [U8C, U8D]\nWE_LOAD = RD & CEP & LOAD & WIN8  [U8B, U5A]\nWE_RAM = WR & CEP & RAM_WE & SLOT2_NM  [U7B, U5B]\nSRAM /WE = !(WE_LOAD | WE_RAM)  [U5C]: /RD and /WR are two gates from /WE\nSRAM /OE = !(RD & CEP & GAME & OE_ADDR)  [U6A, U7C]\nSRAM U3 /CE = !SA19  [U4C];  SRAM U2 /CE = SA19\n\ntools/check_glue.py evaluates this netlist against the firmware's own C functions\nfor every input combination."
		(exclude_from_sim no)
		(at 73.66 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "751de750-20da-5f1b-8f41-15fed4186f97")
	)
