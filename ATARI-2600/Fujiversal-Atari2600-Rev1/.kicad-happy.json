// kicad-happy project config for Fujiversal-Atari2600 Rev1 (JSONC)
{
  "version": 1,
  "project": {
    "name": "Fujiversal-Atari2600 Rev1",
    "revision": "1",
    "company": "FujiNet",
    "market": "us",
    "emc_standard": "fcc-class-b",
    "pdn_transient_current_a": 0.5
  },
  "preferred_suppliers": ["lcsc"],
  "bom": { "field_priority": ["MPN", "LCSC"], "group_by": "value+footprint" },
  "design_intent": {
    "product_class": "prototype",
    "target_market": "hobby",
    "ipc_class": 2,
    "preferred_passive_size": "0603",
    "operating_temp_range": [0, 70]
  },
  "analysis": {
    "output_dir": "analysis",
    "retention": 5,
    "auto_diff": true,
    "track_in_git": false,
    "power_rails": {
      // divider nodes that only look like rails by name
      "ignore": ["VBUS_SNS", "VSENSE"],
      "voltage_overrides": { "+3V3_RP": 3.3, "+5V": 5.0, "CONS_5V": 5.0, "DVDD": 1.1, "VREG_AVDD": 3.3 }
    }
  },
  "suppressions": [
    { "rule_id": "PU-001", "components": ["U3"],
      "reason": "CP2102N CHREN/CHR0/CHR1 are charger-detect outputs, left open as in the ESP32-S3-DevKitC-1 reference." },
    { "rule_id": "RS-001", "nets": ["VBUS_SNS"],
      "reason": "CP2102N VBUS sense divider node (22k/47k), not a rail." },
    { "rule_id": "KO-001", "components": ["J1"],
      "reason": "The finger-strip rule areas forbid tracks, vias and pour but allow pads: the gold fingers are meant to be there." },
    { "rule_id": "DC-002", "components": ["U4"],
      "reason": "UMH3N is a dual pre-biased transistor (auto-program); it has no supply pin to decouple." },
    { "rule_id": "PM-002", "components": ["J1", "J2", "J3"],
      "reason": "Edge connectors: the cart fingers, the microSD mouth on the right edge and the USB-C mouth on the top edge sit at the edge by design." },
    { "rule_id": "EP-AUD", "components": ["J1", "J2"],
      "reason": "J1 is the console bus (the RP2350 FT pads carry 4 kV HBM; no 2600 cart has ESD parts); J2 microSD sits inside the shell." },
    { "rule_id": "CG-AUD", "components": ["J1"],
      "reason": "Console-defined 24-pin 2600 edge: two GND fingers by Atari's pinout." }
  ]
}
