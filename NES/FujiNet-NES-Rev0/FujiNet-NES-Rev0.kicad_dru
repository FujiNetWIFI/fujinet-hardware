(version 1)
(rule "rp2350_core_corner"
	(condition "A.NetName == 'DVDD' || A.NetName == 'RP_LX' || A.NetName == 'VREG_AVDD'")
	(constraint clearance (min 0.12mm)))
(rule "default_clearance"
	(condition "A.NetName != 'DVDD' && A.NetName != 'RP_LX' && A.NetName != 'VREG_AVDD' && B.NetName != 'DVDD' && B.NetName != 'RP_LX' && B.NetName != 'VREG_AVDD'")
	(constraint clearance (min 0.12mm)))
(rule "gnd_solid_under_ics"
	(condition "A.NetName == 'GND' && (A.memberOfFootprint('U1') || A.memberOfFootprint('U2') || A.memberOfFootprint('U3') || A.memberOfFootprint('U14') || A.memberOfFootprint('U15'))")
	(constraint zone_connection solid))
(rule "finger_edge"
	(condition "A.memberOfFootprint('J1')")
	(constraint edge_clearance (min 0.9mm)))
