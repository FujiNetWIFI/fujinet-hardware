# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml

# Python bytecode and KiCad lock files
__pycache__/
*.pyc
~*.lck

# kicad-happy analyzer runs and downloaded datasheets (manifest kept)
**/analysis/
**/datasheets/*.pdf
**/datasheets/extracted/

# Freerouting console output written by tools/route.py
**/exports/freerouting.log

# Astrocade Rev0: kicad-happy runs and the downloaded (third-party) datasheets
Astrocade/rev0/analysis/
Astrocade/rev0/datasheets/
Astrocade/rev0/tools/.sch_geometry.json

# SMS Rev0: raw EasyEDA API answers cached by tools/audit/jlc/measure_rotations.py (re-fetchable)
SMS/FujiNet-SMS-Rev0/tools/audit/jlc/easyeda_cache/
