	(text "fujinet-firmware pico/atari-7800 a78_cart.h: a78_cartsel(), a78_glue_oe(), a78_glue_we(),\na78_glue_a8().  RW = 1 for a read; ROM_EN, RAM_EN, A8MASK = RP GPIO38, 39, 40 (the PIO slot\ntable); PWR_OK = console +5V present.\n\nCARTSEL = A15 | A14 | !A15 & !A14 & !A13 & A12 & !A11 | !A15 & !A14 & A13 & A12\n        = A15 | A14 | A12 & (A13 | !A11)\nLOW_X = A13 | !A11 = NAND(A13_N, A11)  [U3C, U4A]\nA15_P_N = !(A15 & PWR_OK), A14_P_N = !(A14 & PWR_OK)  [U4B, U4C]\nLOW_P_N = !(A12 & LOW_X & PWR_OK)  [U5A]\nCSEL_P = NAND(A15_P_N, A14_P_N, LOW_P_N) = PWR_OK & CARTSEL  [U5B]\nSRAM /OE = !(CSEL_P & RW & ROM_EN)  [U6A]: no PHI2, MARIA DMA is not PHI2-aligned\nSRAM /WE = !(CSEL_P & !RW & PHI2 & RAM_EN)  [U3D, U6B]: PHI2 is one gate from /WE\nSRAM A8 = A8 & !A8MASK  [U3E, U4D, U3F]\n\ntools/check_glue.py evaluates this netlist against the firmware's own C functions\nfor every input combination."
		(exclude_from_sim no)
		(at 53.34 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "94d8501b-a98a-5945-8f48-abeee5a19555")
	)
	(embedded_fonts no)
