	(text "Atari 7800 32-pin cartridge edge, drawn by function (finger numbers on the pins).\nPins 1-16 face pins 32-17 (k over 33-k); 3-14 and 19-30 are the 2600 edge.  ASSUMED, verify\non a real cart PCB: pins 1-16 on the console-rear face, pin 1 at the LEFT seen from that face\nwith the fingers down.  No chip select, no reset: the glue decodes A15-A11 itself."
		(exclude_from_sim no)
		(at 157.48 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cdd9abca-498c-5c85-9cf2-850dfce81e89")
	)
	(text "Cart audio: GPIO29 PWM (833 kHz carrier) -> 1.5k / 10n (fc 10.6 kHz) -> 10k -> 1u -> EAUDIO.\nThe 10k level is PROVISIONAL (match a POKEY cart on a real console); the 1u keeps the\nconsole's audio node at its no-cart DC level."
		(exclude_from_sim no)
		(at 157.48 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ac77b256-fab0-52e6-b489-559be9f00e1d")
	)
	(embedded_fonts no)
)
