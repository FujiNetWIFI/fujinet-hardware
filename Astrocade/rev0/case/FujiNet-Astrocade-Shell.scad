// FujiNet-Astrocade Rev0 cartridge shell (parametric, two-piece)
// ---------------------------------------------------------------------------
// The Bally Astrocade "Videocade" is a closed cassette-style cart. The console's blade (a single-row
// 26-contact wafer) enters a slot in the cart's leading face, under the board, and its springs press
// UP on the gold lands on the board's underside. The cart lies label-up in an open-top well, with
// only its leading section under the console's mouth.
//
// The leading section is a stock cart's: 100 mm wide and 12.0 mm thick, with the blade slot, the
// blade-stop rib and the board plane. All of these are measured from Lance F. Squire's (Komb)
// printed Astrocade cart shell, Thingiverse thing:173532, CC BY 3.0 ("Working cart shell"; an
// original measures 12.27 mm thick). No code is taken from it. Behind that section the shell rises
// to 15.5 mm for the parts. The USB-C and microSD sit flush with the trailing face, and a hood
// covers the ESP32-S3 antenna that overhangs the board's trailing edge. case/case-spec.md has every
// number and its source; the ones marked VERIFY there were not measured on a console.
//
// Frame:  X = across the cart, 0 = the board's centre line (board x 100);
//         Y = depth, 0 = the LEADING face (the blade enters here), growing toward the trailing face;
//         Z = 0 at the outside bottom, growing toward the label face.
// BOTTOM half = Z 0 .. z_b (the board's underside); TOP half = z_b up. The board is clamped between
// them: the bottom half's bosses and blade-stop rib under it, the top half's bosses and its solid
// front section (over the part-free contact strip) on it. Four M3 screws go in from the bottom,
// through the board's holes, into pilot holes in the top half.
//
// Print: bottom half floor-down; top half roof-down (`part = "top"` exports it turned over by a
// rotation, never a mirror); plunger cap-down. Resin (JLC3DP) or FDM, no supports.
// Screws: M3 self-tapping pan head, 2x M3x10 at the front holes and 2x M3x12 at the rear holes.

include <board-anchors.scad>   // generated by tools/gen_pcb.py (placement)
include <board-parts.scad>     // generated by tools/case_parts.py (the routed board's top-side parts)

// ------------------------------------------------------------ parameters --
cart_w    = 100.0;  // outside width (Komb 100)
lead_h    = 12.0;   // leading-section thickness (Komb 2 x 6.0; an original measures 12.27)
lead_d    = 18.0;   // the 12 mm section ends here (Komb's clamp shelf ends 18.27 in; no top-side part
                    // within 19.3 mm of the face); a 45-degree chamfer then rises to body_h
body_h    = 15.5;   // rear body (open well above it)
wall      = 1.5;    // side walls
lead_wall = 1.3;    // leading wall (Komb 1.29)
back_t    = 1.3;    // trailing wall, the USB-C / microSD face
floor_t   = 1.3;    // bottom plate (Komb 1.29): the slot starts at its top
roof_t    = 1.5;
r_out     = 2.0;    // outer vertical-edge radius
clr       = 0.3;    // board edge to the leading and trailing walls
// the console blade (all Komb)
slot_w    = 74.7;   // slot width
slot_z1   = 7.77;   // slot top above the bottom; it runs down to the floor
stop_y    = 12.86;  // blade-stop rib's front face, from the leading face
stop_t    = 1.29;
guide_x0  = 37.35;  // blade-channel side guides at |X| guide_x0 .. guide_x1, leading wall to the rib
guide_x1  = 38.65;
// the board
pcb_t     = 1.6;
z_b       = 7.65;   // board underside: Komb's clamp shelf is 9.25 above the bottom, less a 1.6 board
// screws
boss_b_d  = 7.2;    // bottom bosses (no parts on B.Cu); they merge into the side walls
boss_t_d  = 6.0;    // top bosses (U2 is 0.95 mm from the rear-left one)
screw_d   = 3.4;
pilot_d   = 2.6;    // self-tapping M3
head_d    = 6.2;
head_h    = 1.2;
// ESP32-S3 antenna hood
hood_wall = 1.2;
hood_clr  = 0.4;
// port openings
usb_w = 9.8;   usb_h = 4.0;   usb_zc = 1.63;    // HRO TYPE-C-31-M-12: 8.94 x 3.26, centre above F.Cu
usb_cb = [12.8, 7.0, 0.8];                       // plug-overmold counterbore in the trailing face
sd_w  = 14.0;  sd_z0 = 0.1;   sd_z1 = 2.3;       // TF-015 card slot, above F.Cu
// label face: RESET plunger, three pin-holes, two LED windows, a label recess
pin_d = 2.2;   led_ws_d = 3.0;   led_rp_d = 2.0;
label  = [35, 32];  label_c = [-21.0, 40.0];  label_t = 0.4;
// RESET plunger (the 5200 / 7800 shell's): SKQGABE010 stem 1.5 mm above F.Cu
sw_h      = 1.5;
proud     = 0.6;    // cap above the label face at rest
press_gap = 0.15;   // stem above the switch at rest
cap_d = 5.0;  cap_hole = 5.4;  fl_d = 6.6;  stem_d = 3.0;
guide_od = 8.6;  guide_id = 7.0;

$fn = 48;
eps = 0.01;

// ---------------------------------------------------------- derived frame --
z_f     = z_b + pcb_t;                          // board top (F.Cu)
z_fin   = body_h - roof_t;                      // roof underside (rear body)
setback = lead_wall + clr;                      // board leading edge from the leading face
function cx(x) = x - (pcb_x0 + pcb_x1) / 2;
function cy(y) = setback + (pcb_y1 - y);
back_in  = cy(pcb_y0) + clr;                    // trailing wall, inside
back_out = back_in + back_t;                    // trailing face
chamf    = body_h - lead_h;                     // outer chamfer run (45 degrees)
function part_of(ref) = [for (p = board_parts) if (p[5] == ref) p][0];
u2 = part_of("U2");
hood_x0 = cx(u2[0]) - hood_clr;  hood_x1 = cx(u2[2]) + hood_clr;    // hood inside
hood_y1 = cy(u2[1]) + hood_clr;
hood_out_y = hood_y1 + hood_wall;
guide_h = z_fin - (z_f + sw_h + 0.3);           // the guide stops 0.3 above the switch
cart_d  = hood_out_y;                           // overall depth (at the hood)

function P(p) = [cx(p[0]), cy(p[1])];           // board point -> cart XY

assert(cart_w / 2 - wall - (pcb_x1 - pcb_x0) / 2 >= 0.4, "board wider than the cavity");
assert(z_b - floor_t >= 4.0, "no room for the blade under the board");
assert(slot_z1 > z_b, "the slot must reach the board's underside");
assert(z_fin - z_f >= 3.31 + 0.6, "parts too tall for the rear body");
assert(guide_h >= 2.0, "RESET guide too short");
assert(cy(pcb_y1) < stop_y, "the board starts behind the blade stop");
echo(str("shell: ", cart_w, " x ", back_out, " (", cart_d, " at the antenna hood) x ", body_h,
         " mm; leading section ", lead_h, " mm for ", lead_d, " mm; board underside ", z_b,
         " mm above the bottom, leading edge ", setback, " mm in; blade channel ", stop_y, " mm deep"));

// ---------------------------------------------------------------- envelope --
module rrect(x0, y0, x1, y1, r) {
    translate([x0 + r, y0 + r]) offset(r = r) square([x1 - x0 - 2 * r, y1 - y0 - 2 * r]);
}
// side profile (Y, Z) extruded across X
module across(x0, x1) { translate([x0, 0, 0]) rotate([90, 0, 90]) linear_extrude(x1 - x0) children(); }
module outer() {
    intersection() {
        across(-cart_w / 2 - 1, cart_w / 2 + 1)
            polygon([[0, 0], [back_out, 0], [back_out, body_h], [lead_d + chamf, body_h], [lead_d, lead_h], [0, lead_h]]);
        linear_extrude(body_h) rrect(-cart_w / 2, 0, cart_w / 2, back_out, r_out);
    }
    // the antenna hood behind the trailing face
    linear_extrude(body_h)
        rrect(hood_x0 - hood_wall, back_out - 2 * r_out, hood_x1 + hood_wall, hood_out_y, r_out);
}
// the cavity: open under the board everywhere; above it, only behind the solid front section
module cavity() {
    across(-cart_w / 2 + wall, cart_w / 2 - wall)
        polygon([[lead_wall, floor_t], [back_in, floor_t], [back_in, z_fin],
                 [lead_d + (z_fin - z_f), z_fin], [lead_d, z_f], [lead_wall, z_f]]);
    translate([hood_x0, back_in - eps, floor_t]) cube([hood_x1 - hood_x0, hood_y1 - back_in + eps, z_fin - floor_t]);
}
module blade_slot() {
    translate([-slot_w / 2, -eps, floor_t - eps]) cube([slot_w, lead_wall + 2 * eps, slot_z1 - floor_t + eps]);
}
// under the board: the blade channel's side guides and its stop rib
module blade_frame() {
    for (s = [-1, 1]) translate([s > 0 ? guide_x0 : -guide_x1, lead_wall - eps, 0])
        cube([guide_x1 - guide_x0, stop_y - lead_wall + eps, z_b]);
    translate([-cart_w / 2 + wall - eps, stop_y, 0]) cube([cart_w - 2 * wall + 2 * eps, stop_t, z_b]);
}
module at_holes() { for (h = pcb_holes) translate([cx(h[0]), cy(h[1])]) children(); }

// ---------------------------------------------------------------- openings --
module port_openings() {
    ux = cx(usb_c[0]);
    translate([ux - usb_w / 2, back_in - 1, z_f + usb_zc - usb_h / 2]) cube([usb_w, back_t + 2, usb_h]);
    translate([ux - usb_cb[0] / 2, back_out - usb_cb[2], z_f + usb_zc - usb_cb[1] / 2])
        cube([usb_cb[0], usb_cb[2] + eps, usb_cb[1]]);
    j2 = part_of("J2");
    sx = cx((j2[0] + j2[2]) / 2);
    translate([sx - sd_w / 2, back_in - 1, z_f + sd_z0]) cube([sd_w, back_t + 2, sd_z1 - sd_z0]);
    // a finger dish over the card's end, to push the push-push card home
    translate([sx, back_out + 0.3, body_h]) scale([1, 0.5, 0.5]) sphere(d = 14);
}
module face_holes() {
    translate([P(sw_reset)[0], P(sw_reset)[1], z_fin - 1]) cylinder(d = cap_hole, h = roof_t + 2);
    for (p = [sw_bootsel, sw_s3_en, sw_s3_boot]) translate([P(p)[0], P(p)[1], z_fin - 1]) cylinder(d = pin_d, h = roof_t + 2);
    translate([P(led_ws)[0], P(led_ws)[1], z_fin - 1]) cylinder(d = led_ws_d, h = roof_t + 2);
    translate([P(led_rp)[0], P(led_rp)[1], z_fin - 1]) cylinder(d = led_rp_d, h = roof_t + 2);
    translate([label_c[0] - label[0] / 2, label_c[1] - label[1] / 2, body_h - label_t]) cube([label[0], label[1], label_t + eps]);
}

// ---------------------------------------------------------------- the shell --
// which = "bottom": the walls plus what stands under the board; "top": the walls plus what hangs over
// it.  Each half is cut from its own solid, so nothing ends exactly on the parting plane.
module shell(which = "both") {
    difference() {
        intersection() {
            union() {
                difference() { outer(); cavity(); }
                if (which != "top") {
                    blade_frame();
                    at_holes() cylinder(d = boss_b_d, h = z_b);
                }
                if (which != "bottom") {
                    at_holes() translate([0, 0, z_f]) cylinder(d = boss_t_d, h = z_fin - z_f + eps);
                    translate([P(sw_reset)[0], P(sw_reset)[1], z_fin - guide_h]) cylinder(d = guide_od, h = guide_h + eps);
                }
            }
            outer();
        }
        blade_slot();
        at_holes() translate([0, 0, -eps]) cylinder(d = screw_d, h = z_b + 2 * eps);
        at_holes() translate([0, 0, -eps]) cylinder(d = head_d, h = head_h + eps);
        // pilots stop 0.5 under the outside (1.0 at the front, where the shell is 12 mm)
        for (h = pcb_holes) translate([cx(h[0]), cy(h[1]), z_f - eps])
            cylinder(d = pilot_d, h = (cy(h[1]) < lead_d ? lead_h - 1.0 : body_h - 0.5) - z_f);
        translate([P(sw_reset)[0], P(sw_reset)[1], z_fin - guide_h - eps]) cylinder(d = guide_id, h = guide_h + eps);
        port_openings();
        face_holes();
    }
}
module bottom_half() { intersection() { shell("bottom"); translate([-200, -200, -1]) cube([400, 400, z_b + 1]); } }
module top_half()    { intersection() { shell("top"); translate([-200, -200, z_b]) cube([400, 400, 100]); } }

// RESET plunger, modelled cap-down (its print orientation): the cap through the roof, a 45-degree cone
// into a flange held in the guide, a stem onto the SKQGABE010's stem. At rest the cone sits on the
// hole's edge, the cap `proud` above the face and the stem `press_gap` above the switch.
cap_l    = roof_t + proud - (cap_hole - cap_d) / 2;
cone_h   = (fl_d - cap_d) / 2;
stem_end = roof_t + proud + (z_fin - z_f) - sw_h - press_gap;   // from the cap's top
module plunger() {
    cylinder(d = cap_d, h = cap_l + eps);
    translate([0, 0, cap_l]) cylinder(d1 = cap_d, d2 = fl_d, h = cone_h);
    translate([0, 0, cap_l + cone_h - eps]) cylinder(d = fl_d, h = 0.7 + eps);
    translate([0, 0, cap_l + cone_h + 0.7 - eps]) cylinder(d = stem_d, h = stem_end - (cap_l + cone_h + 0.7) + eps);
}
module plunger_fitted(drop = 0) {   // drop > 0 lowers it off the hole's edge
    translate([P(sw_reset)[0], P(sw_reset)[1], body_h + proud - drop]) rotate([180, 0, 0]) plunger();
}

// the board and its top-side parts, for the "assembled" / "check" views
module board(shrink = 0) {
    translate([0, 0, z_b + shrink]) linear_extrude(pcb_t - 2 * shrink)
        rrect(cx(pcb_x0) + shrink, cy(pcb_y1) + shrink, cx(pcb_x1) - shrink, cy(pcb_y0) - shrink, pcb_r);
}
module parts(shrink = 0, skip = "") {
    for (p = board_parts) if (p[5] != skip)
        translate([cx(p[0]) + shrink, cy(p[3]) + shrink, z_f + shrink])
            cube([p[2] - p[0] - 2 * shrink, p[3] - p[1] - 2 * shrink, p[4] - shrink]);
}

// the console blade's room: the slot's width, floor to the board, the leading face to the stop rib
module blade() {
    translate([-(slot_w / 2 - 0.05), -1, floor_t + 0.05]) cube([slot_w - 0.1, stop_y - 0.05 + 1, z_b - floor_t - 0.1]);
}

// ---------------------------------------------------------------- output --
part = "assembled";   // "bottom", "top", "plunger" (print orientation), "assembled", "check"
if (part == "bottom") bottom_half();
else if (part == "top") translate([0, back_out, body_h]) rotate([180, 0, 0]) top_half();   // roof down, a rotation
else if (part == "plunger") plunger();
else if (part == "assembled") {
    bottom_half(); color("dimgray", 0.5) top_half();
    color("green") board(); color("orange") parts(); color("red") plunger_fitted();
}
else if (part == "check") {          // every intersection must be empty
    intersection() { board(0.05); shell(); }                       // the board only touches its supports
    intersection() { parts(0.05); shell(); }                       // no part touches the shell
    intersection() { plunger_fitted(0.05); top_half(); }           // the plunger only rests on the hole's edge
    intersection() { plunger_fitted(0); parts(0); }                // and every part (its switch by press_gap)
    intersection() { blade(); shell(); }                           // the blade's way in is clear to the stop
}
