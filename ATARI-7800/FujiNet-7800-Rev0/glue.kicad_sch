	(text "fujinet-firmware pico/atari-7800 a78_cart.h: a78_cartsel(), a78_glue_oe(), a78_glue_we(), a78_glue_a8().\nRW = 1 for a read; ROM_EN, RAM_EN, A8MASK = RP GPIO38, 39, 40 (the PIO slot table; 4.7k pull-downs hold\nthem low until it runs, RP2350-E9); PWR_OK = console +5V present (0.82 x CONS_5V into the 74HCT14).\nCARTSEL = A15 | A14 | A12 & (A13 | !A11)   ($4000-$FFFF, $1000-$17FF, $3000-$3FFF)\nCSEL_P = PWR_OK & CARTSEL = NAND(!(A15 & PWR_OK), !(A14 & PWR_OK), !(A12 & LOW_X & PWR_OK))\nSRAM /OE = !(CSEL_P & RW & ROM_EN)   (no PHI2: MARIA DMA is not PHI2-aligned)\nSRAM /WE = !(CSEL_P & !RW & PHI2 & RAM_EN)   (PHI2 one gate from /WE);   SRAM A8 = A8 & !A8MASK\ntools/check_glue.py evaluates this netlist against the firmware's C for every input combination."
		(exclude_from_sim no)
		(at 58.42 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d55506ca-2762-5d7d-b607-a957e78dd808")
	)
