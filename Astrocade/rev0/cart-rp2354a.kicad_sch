	(text "CARTRIDGE PORT + RP2354A BUS SERVER"
		(exclude_from_sim no)
		(at 40.64 30.48 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left top)
		)
		(uuid "23082a7b-0213-581c-a863-639f0c731511")
	)
	(text "Bally Astrocade cassette port, 26 contacts on the PCB UNDERSIDE (the console blade presses up), Tilton 1-26.\nThe RP2354A (RP2350A + 2 MB flash in package) serves the 8K cart window straight off the 5 V bus: A0-A12 = GP0-12,\n/CCS = GP13, D0-D7 = GP14-21 (astrocade_cart.h).  No buffers: the RP2350 fault-tolerant pads take 5.5 V while\nIOVDD is up, and +3V3_RP (power sheet, LDO) follows the console rail as it rises.  The firmware drives D0-D7\nonly while /CCS is low AND VSENSE is high, so a USB-powered cart never drives a dead console."
		(exclude_from_sim no)
		(at 40.64 38.1 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "013beb34-f6ac-58b8-b418-c65f23db48a1")
	)
	(text "Decoupling: one 100 nF at each IOVDD / QSPI_IOVDD / USB_OTP_VDD / ADC_AVDD pin, 4.7 uF at VREG_VIN, 10 uF bulk;\nDVDD 3 x 100 nF + 4.7 uF at the core regulator output.  Regulator corner per the Raspberry Pi RP2350A minimal design."
		(exclude_from_sim no)
		(at 76.2 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b0d59157-ef77-51d7-89a5-2b1f6ec91c0f")
	)
	(text "VSENSE: console +5V x 0.6 (3.0 V; 3.15 V at 5.25 V).\nGP26 is an ADC pad, not 5 V tolerant."
		(exclude_from_sim no)
		(at 106.68 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "071a266c-79b9-55a1-afec-8afbb37b86e1")
	)
	(text "Activity LED (GP25)"
		(exclude_from_sim no)
		(at 106.68 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7a3b3f66-13e5-59e8-9934-7aa0fc11c2b3")
	)
	(text "RP <-> S3 native USB (S3 = host)"
		(exclude_from_sim no)
		(at 279.4 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b6738c6-1257-50ec-9903-bc60ec9dff41")
	)
	(text "RUN: pulled up; S3 IO4 (1k) and the RESET\nbutton (S3 sheet) pull it low"
		(exclude_from_sim no)
		(at 279.4 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "488d03ca-2b10-59cb-bc55-d1071341909a")
	)
	(text "BOOTSEL: QSPI_SS low through reset = USB boot;\nS3 IO5 (1k) or SW1 (pinhole)"
		(exclude_from_sim no)
		(at 279.4 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1b975e81-a7e9-5a26-a9ce-3282169d6af3")
	)
